# ---------------------------------------------------------------------------
# Vantage environment. Copy to `.env` and fill in. Nothing here is required to
# run the simulated backend -- `vantage demo` works with no keys at all.
# ---------------------------------------------------------------------------

# Frontier / hosted baseline (OpenAI-compatible). Used as the "teacher" and as
# the API-cost baseline in the cost model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# A locally served OpenAI-compatible endpoint (vLLM, TGI, llama.cpp, LM Studio,
# Ollama). No key needed for most of these; vLLM accepts any string.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Embeddings used by the semantic cache. Leave blank to use the built-in
# offline hashing embedder (deterministic, no network, good enough for sweeps).
VANTAGE_EMBEDDER=hashing          # hashing | openai | sentence-transformers
VANTAGE_EMBEDDING_MODEL=text-embedding-3-small

# Where run artefacts are written.
VANTAGE_RESULTS_DIR=results
